# Fine-grained token: Repository permissions -> Administration: Read-only (нужно для Traffic API),
# Metadata: Read-only, Issues: Read-only, Pull requests: Read-only. Доступ: All repositories.
GITHUB_TOKEN=
GITHUB_USER=AleksandrSrk
# Classic-токен БЕЗ единой галочки прав: для списков звёзд, подписчиков и форков репо
# (fine-grained токен к ним не пускает, а без авторизации GitHub их не отдаёт)
GITHUB_PUBLIC_TOKEN=

# Токен бота от @BotFather и твой Telegram ID (бот отвечает только ему)
TG_BOT_TOKEN=
TG_ADMIN_ID=

# Интервал опроса в секундах (3600 = раз в час)
POLL_INTERVAL=3600
# Следить и за приватными репозиториями
INCLUDE_PRIVATE=false
# Полный недельный отчёт: день (0 = понедельник, 6 = воскресенье) и час
DIGEST_WEEKDAY=6
DIGEST_HOUR=20

DATA_DIR=./data
